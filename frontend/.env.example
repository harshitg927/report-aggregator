# Base URL of the report-aggregator FastAPI service.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Editor: files larger than this (bytes) are opened in plain-text mode
# (syntax highlighting off, editing and save still fully enabled).
# Default: 2097152 (2 MB).
NEXT_PUBLIC_EDITOR_HIGHLIGHT_MAX_BYTES=2097152
